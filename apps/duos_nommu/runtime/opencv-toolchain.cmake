set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR riscv64)
get_filename_component(SDK "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(CROSS "${SDK}/host-tools/gcc/riscv64-linux-musl-x86_64/bin/riscv64-unknown-linux-musl-")
set(CMAKE_C_COMPILER "${CROSS}gcc")
set(CMAKE_CXX_COMPILER "${CROSS}g++")
if(NOT DEFINED NOMMU_OPENCV_ABI)
    set(NOMMU_OPENCV_ABI lp64)
endif()
if(NOMMU_OPENCV_ABI STREQUAL "lp64d")
    set(NOMMU_OPENCV_ARCH rv64imafdc)
elseif(NOMMU_OPENCV_ABI STREQUAL "lp64")
    set(NOMMU_OPENCV_ARCH rv64imac)
else()
    message(FATAL_ERROR "Unsupported ABI")
endif()
set(CMAKE_C_FLAGS_INIT "-march=${NOMMU_OPENCV_ARCH} -mabi=${NOMMU_OPENCV_ABI} -fPIC")
set(CMAKE_CXX_FLAGS_INIT "-march=${NOMMU_OPENCV_ARCH} -mabi=${NOMMU_OPENCV_ABI} -fPIC")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
