# Everything here is staged by apps/tinytag_detect/build.sh from sources kept in
# apps/tinytag_detect/ and tools/tinytag_cvimodel/. Regenerate rather than
# commit, so the staged copies cannot drift from their sources.
app/tinytag_detect/tinytag_detect
app/tinytag_detect/tinytag_detect_live
app/tinytag_detect/run_tinytag.sh
app/tinytag_detect/cvimodel/*.ttgold
app/tinytag_detect/samples/
usr/local/bin/run_tinytag.sh
root/.ssh/

# The cvimodel IS tracked. Per tools/tinytag_cvimodel/README.md only a
# hardware-validated model belongs in the repo, and this one qualifies: it ran
# on a Duo S and reproduced tpu-mlir's simulator bit-exactly (worst element
# 0.000000) -- see docs/duo-s-performance-findings.md. Committing it means a
# fresh clone can build a working detector without the ONNX model, the
# calibration footage, or the tpu-mlir container.
#
# The ONNX and .pt sources stay external, as does the .ttgold golden bundle
# (3.2 MB, regenerate with tools/tinytag_cvimodel/make_golden.py when needed
# for --selftest).
